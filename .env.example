# Local development only. Copy to .env; never commit a populated .env.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
ALLOW_DEV_AUTH=true
MEDIA_STORAGE=local

# npm workspace commands run from apps/api. Docker uses its own absolute STATIC_DIR.
LOCAL_MEDIA_DIR=../../.local/media
STATIC_DIR=../miniapp/dist

# The embedded PostgreSQL helper writes random local credentials to .local/postgres.env.
# Leave these absent to use that file through scripts/with-local-env.mjs.
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/splint_dev
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/splint_test

# Telegram credentials are unnecessary for explicit local demo mode.
# BOT_TOKEN=
# BOT_USERNAME=
# WEBHOOK_SECRET=
# SESSION_ENCRYPTION_KEY=

# Production requires MEDIA_STORAGE=r2, ALLOW_DEV_AUTH=false, an HTTPS APP_ORIGIN,
# a random SESSION_ENCRYPTION_KEY (at least 32 characters), a test bot, and private R2.
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Optional Docker PostgreSQL alternative (local loopback only):
# LOCAL_POSTGRES_PASSWORD=choose-a-local-development-password
